# RPC Configuration
RPC_URL=http://192.168.0.50:8899
RPC_WS_URL=ws://192.168.0.50:8900

# Geyser gRPC endpoint (tu nodo local debe tener Yellowstone gRPC configurado)
GEYSER_ENDPOINT=http://192.168.0.50:10000
GEYSER_X_TOKEN=

# Wallet Configuration
WALLET_KEYPAIR_PATH=./wallet.json

# Meteora DAMM V2 Program ID
METEORA_PROGRAM_ID=cpamdpZCGKUy5JxQXB4dcpGPiikHawvSWAd6mEn1sGG

# Trading Configuration
AUTO_BUY_ENABLED=false  # ⚠️ Iniciar en modo observación
AUTO_BUY_AMOUNT_SOL=0.01  # Usar 0.01 para primera prueba

# Slippage Configuration
BUY_SLIPPAGE_BPS=9900   # 99% - Alto para entrar en pools nuevos con poca liquidez
SELL_SLIPPAGE_BPS=4000  # 40% - Menor para proteger ganancias en venta

# Priority Fee (micro-lamports por CU)
# ⚠️ IMPORTANTE: set_compute_unit_price() espera micro-lamports/CU, NO lamports totales
#
# Cálculo: (lamports_totales_deseados × 1,000,000) / compute_units
# Ejemplo: (100,000 lamports × 1,000,000) / 300,000 CU = 333 micro-lamports/CU
#
# Valores recomendados:
# 33   = ~10k lamports totales  (~$0.0003/TX) - Ultra económico
# 167  = ~50k lamports totales  (~$0.0015/TX) - Económico
# 333  = ~100k lamports totales (~$0.003/TX)  - Normal (RECOMENDADO)
# 1667 = ~500k lamports totales (~$0.015/TX)  - Alta prioridad
# 3333 = ~1M lamports totales   (~$0.03/TX)   - Máxima prioridad
PRIORITY_FEE_LAMPORTS=333  # ~0.0001 SOL total (~$0.003 por TX)

# Risk Management
TAKE_PROFIT_PERCENT=10.0  # 10%
STOP_LOSS_PERCENT=-2.0    # -2%

# Monitoring
MIN_LIQUIDITY_SOL=1.0
